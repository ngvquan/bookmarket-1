PORT=4000
PAYMENT_BANK_ID=
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NO=
PAYMENT_ACCOUNT_NAME=
PAYMENT_QR_TEMPLATE=compact2
# Tu tao secret it nhat 32 ky tu va dat cung gia tri o SePay (API Key).
PAYMENT_WEBHOOK_SECRET=
MONGO_URI=mongodb://127.0.0.1:27018/bookmarket_foundation?replicaSet=bookmarket-rs
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development
# Chatbot AI local mien phi bang Ollama. Doi AI_PROVIDER=openai neu dung OpenAI.
AI_PROVIDER=ollama
# Nếu frontend đăng nhập qua backend triển khai khác, điền URL backend đó để tra đơn của chính khách.
AI_ACCOUNT_API_URL=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=hf.co/unsloth/Qwen3-8B-GGUF:Q3_K_S
OLLAMA_FALLBACK_MODEL=qwen3:4b
AI_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Cau hinh nhe van chay khi GPU dang ban; dat OLLAMA_NUM_GPU=999 khi may ranh.
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_NUM_GPU=99
AI_TEMPERATURE=0.3
# Tuy chon: chi can khi AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-astra
# Bo trong de luu tai backend/storage; production nen dat o o dia ben vung.
BOOKMARKET_STORAGE_DIR=
# Public development seed credentials only; choose a different password before real use.
SEED_PASSWORD=BookMarket123!
# Tests refuse to run against the application database.
TEST_MONGO_URI=mongodb://127.0.0.1:27018/bookmarket_test?replicaSet=bookmarket-rs
